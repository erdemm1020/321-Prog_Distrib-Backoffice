<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Backoffice.MainWindow"
        Title="Backoffice"
        Background="#D4D0C8"
        FontFamily="Tahoma, Verdana, Arial"
        RequestedThemeVariant="Light">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="BorderThickness" Value="1,1,2,2" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="180" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D4D0C8" />
            <Setter Property="BorderBrush" Value="#404040" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E0DCD4" />
            <Setter Property="BorderBrush" Value="#000080" />
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#BFBBB3" />
            <Setter Property="BorderThickness" Value="2,2,1,1" />
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
    </Window.Styles>

    <Grid Margin="16">
    <StackPanel Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Image x:Name="BusinessImage" Width="650" Height="250"
               Stretch="Fill" HorizontalAlignment="Left" />
        <TextBlock x:Name="BusinessNameText" FontSize="20" FontWeight="Bold" Foreground="#000080" />
        <TextBlock x:Name="BusinessIdText" Foreground="Black" />

        <TextBlock Text="Produit phare :" FontWeight="Bold" Foreground="Black" Margin="0,12,0,0" />
        <Image x:Name="ProductImage" Width="150" Height="150"
               Stretch="UniformToFill" HorizontalAlignment="Left" />
        <TextBlock x:Name="ProductNameText" Foreground="Black" />
        <TextBlock x:Name="ProductPriceText" Foreground="Black" />
    </StackPanel>
    
    <StackPanel HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Spacing="4">

        <TextBlock x:Name="UnixTimeStamp"
               Foreground="Black"
               HorizontalAlignment="Right" />

        <Button Content="Exporter JSON"
            Click="OnClick_ExportButton" />

    </StackPanel>
</Grid>

</Window>